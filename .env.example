# ===== Mac-Buddy · 麦麦搭子｜后端环境变量 =====
# 使用方式：复制本文件为 apps/server/.env 后填写。
# apps/server/.env 已被 .gitignore 忽略，绝不会进入版本库。**不要**往本文件里填真实 Token。

# 麦当劳 MCP Token（仅后端使用，绝不暴露到前端或浏览器）。
# 在 https://open.mcd.cn/mcp 申请后，把完整 Token 粘贴到等号后面
# （不含 "Bearer " 前缀，后端会自动添加）。
# 不填写时，后端自动运行“演示模式”，使用内置虚构数据，不会产生任何真实订单。
MCD_MCP_TOKEN=

# 后端监听端口（默认 8787）。仅监听 127.0.0.1，请勿直接暴露到公网。
PORT=8787

# 麦当劳 MCP 服务地址（一般无需修改）。
MCD_MCP_URL=https://mcp.mcd.cn

# 设置为 true 可强制演示模式（即使已配置 Token）。
# 演示模式：虚构门店/菜单/营养/券，不调用真实接口，不产生真实订单。
FORCE_DEMO_MODE=false

# 本地 SQLite 数据目录（可选）。默认 apps/server/data。
# 测试会使用临时目录，不受此变量影响。
# MCD_DATA_DIR=
